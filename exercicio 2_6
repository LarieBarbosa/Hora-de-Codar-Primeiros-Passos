programa
{
	
	funcao inicio()
	{
		inteiro numero1
		inteiro numero2
		inteiro numero3
		inteiro numero4
		inteiro maior

		escreva("Digite o primeiro número: ")
		leia(numero1)

		escreva("Digite o seguno número: ")
		leia(numero2)

		escreva("Digite o terceiro número: ")
		leia(numero3)

		escreva("Digite o quarto número: ")
		leia(numero4)

		se (numero1 > numero2 e numero1 > numero3 e numero1 > numero4)
		{
			maior = numero1
		}
		senao se (numero2 > numero1 e numero2 > numero3 e numero2 > numero4)
		{
			maior = numero2
		}
		senao se (numero3 > numero1 e numero3 > numero2 e numero3 > numero4)
		{
			maior = numero3
		}
		senao 
		{
			maior = numero4
		}

		escreva("Primeiro: ", numero1)
		escreva("\nÚltimo: ", numero4)
		escreva("\nMaior: ", maior)
	}
}

programa
{
	
	funcao inicio()
	{
		inteiro numero1
		inteiro numero2
		inteiro numero3
		inteiro numero4
		inteiro numero5
		inteiro numero6
		inteiro soma 

		soma = 0

		escreva("Digite o primeiro número: ")

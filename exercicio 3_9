programa
{
	
	funcao inicio()
	{
		inteiro valor
		inteiro contador
		inteiro dentro 
		inteiro fora

		dentro = 0
		fora = 0

		para (contador = 1; contador <= 10; contador++)
		{
			escreva("Digite o ", contador, ": ")
			leia(valor)

			se (valor  >= 24 e valor <= 42)
			{
				dentro = dentro + 1
			}
			senao
			{
				fora = fora + 1
			}
		}

		escreva("Valores entre 24 e 42: ", dentro, "\n")
		escreva("Valores fora do intervalo: ", fora)
	}
}
